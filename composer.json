{
    "name": "carmenromano/laravel-flussi-h-validator",
    "description": "Validatore Laravel per i tracciati regionali campani H1 (ANA) e H2 (SAN)",
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-zip": "*",
        "php": ">=7.3",
        "illuminate/console": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "FlussiH\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlussiH\\Validator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FlussiH\\Validator\\FlussiHServiceProvider"
            ],
            "aliases": {
                "FlussiH": "FlussiH\\Validator\\Facades\\FlussiH"
            }
        }
    },
    "scripts": {
        "test": "@php -d zend.assertions=1 -d assert.exception=1 tests/smoke.php",
        "check": [
            "@composer validate --strict",
            "@php tests/smoke.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
